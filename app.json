{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memento",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10151f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.memento.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Memento to detect and scan receipts.",
        "NSPhotoLibraryUsageDescription": "Allow Memento to import receipt photos.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Images",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.image", "public.jpeg", "public.png"]
          },
          {
            "CFBundleTypeName": "PDF",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.adobe.pdf"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.memento.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "application/pdf" }
          ]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "application/pdf" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memento to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memento to import receipt photos."
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#10151f",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#10151f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenueCatIosApiKey": "",
      "revenueCatAndroidApiKey": "",
      "revenueCatProEntitlement": "pro",
      "revenueCatProPlusEntitlement": "pro_plus",
      "revenueCatDevUnlock": false
    }
  }
}
